# Dependencies — reinstalled inside the image
node_modules/

# Build output — built inside the image
dist/
dist-ssr/

# Environment files — secrets must never be baked into the image
.env
.env.*
!.env.example

# Git
.git/
.gitignore

# Editor / OS
.vscode/
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Docker files themselves (no need to COPY them)
Dockerfile
.dockerignore

# Readme / docs
README.md
